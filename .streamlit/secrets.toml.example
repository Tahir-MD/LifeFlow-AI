# Copy these into Streamlit Cloud -> App settings -> Secrets
LIFEFLOW_SECRET_KEY = "put-a-long-random-string-here"
# Optional: persistent database (e.g. free Neon/Supabase Postgres). Without it, SQLite is used
# and data resets whenever Streamlit Cloud restarts the app.
# LIFEFLOW_DATABASE_URL = "postgresql+psycopg2://user:pass@host/db"
# Optional: real LLM for chatbot / report analyzer
# GROQ_API_KEY = "gsk_..."
